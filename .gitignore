## =========================================================
## GLOBAL .gitignore – APPLY FOR ALL SUB PROJECTS
## Visual Studio / .NET / Rider / Node / Python
## =========================================================

############################
# User-specific files
############################
**/*.rsuser
**/*.suo
**/*.user
**/*.userosscache
**/*.sln.docstates
**/*.userprefs

############################
# IDE folders
############################
**/.vs/
**/.idea/
**/.vscode/
**/.ionide/
**/.localhistory/

############################
# Mono / Xamarin
############################
mono_crash.*

############################
# Build results (ALL projects)
############################
**/[Dd]ebug/
**/[Dd]ebugPublic/
**/[Rr]elease/
**/[Rr]eleases/
**/x64/
**/x86/
**/[Ww][Ii][Nn]32/
**/[Aa][Rr][Mm]/
**/[Aa][Rr][Mm]64/
**/bld/
**/[Bb]in/
**/[Oo]bj/
**/[Oo]ut/
**/[Ll]og/
**/[Ll]ogs/
**/publish/

############################
# Visual Studio generated
############################
**/Generated Files/
**/*.ilk
**/*.meta
**/*.obj
**/*.iobj
**/*.pch
**/*.pdb
**/*.ipdb
**/*.pgc
**/*.pgd
**/*.rsp
**/*.tlb
**/*.tli
**/*.tlh
**/*.tmp
**/*.tmp_proj
**/*_wpftmp.csproj
**/*.vspscc
**/*.vssscc
**/*.pidb
**/*.svclog
**/*.scc

############################
# Test / Coverage
############################
**/[Tt]est[Rr]esult*/
**/*.VisualState.xml
**/TestResult.xml
**/nunit-*.xml
**/BenchmarkDotNet.Artifacts/
**/*.coverage
**/*.coveragexml
**/*.dotCover
**/.axoCover/*
!**/.axoCover/settings.json
**/coverage*.json
**/coverage*.xml
**/coverage*.info

############################
# NuGet
############################
**/*.nupkg
**/*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
**/*.nuget.props
**/*.nuget.targets

############################
# ASP.NET / .NET Core
############################
**/project.lock.json
**/project.fragment.lock.json
**/artifacts/
**/ScaffoldingReadMe.txt
**/*.build.csdef
**/*.binlog
**/healthchecksdb

############################
# Azure
############################
**/PublishScripts/
**/*.azurePubxml
**/*.pubxml
**/*.publishproj
**/csx/
**/ecf/
**/rcf/

############################
# Node / Frontend
############################
**/node_modules/
**/dist/
**/build/
**/.next/
**/.nuxt/

############################
# Python
############################
**/__pycache__/
**/*.pyc

############################
# Databases / Secrets
############################
**/*.mdf
**/*.ldf
**/*.ndf
**/*.pfx
**/*.publishsettings
**/*.snk

############################
# OS / Backup
############################
**/.DS_Store
**/Thumbs.db
**/~$*
**/*~
**/Backup*/
**/_UpgradeReport_Files/
**/MigrationBackup/
**/*.rptproj.bak

############################
# Logs
############################
**/*.log

############################
# Others
############################
**/ClientBin/
**/_ReSharper*/
**/*.[Rr]e[Ss]harper
**/*.DotSettings.user
**/_TeamCity*
**/_NCrunch_*
**/nCrunchTemp_*
**/*.mm.*
**/.fake/
**/paket-files/
**/.paket/paket.exe
**/.cr/personal
**/.mfractor/
**/.ionide/
**/FakesAssemblies/
**/OpenCover/
**/ASALocalRun/
**/*.nvuser
**/*.tss
**/*.jmconfig
**/*.GhostDoc.xml
**/FodyWeavers.xsd

############################
# ASP.NET Core appsettings
############################

# Ignore all environment-specific appsettings
**/appsettings.*.json

# BUT keep the base config
!**/appsettings.json
